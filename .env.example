# PostgreSQL connection string (Render provides this automatically when you
# link the database to the web service).
DATABASE_URL="postgresql://user:password@localhost:5432/spec_ed_progress_tracker"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Base URL of the deployed app (Render fills this in for you in production).
NEXTAUTH_URL="http://localhost:3000"
